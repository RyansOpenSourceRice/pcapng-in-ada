with "../pcapng_in_ada.gpr";

project Examples is

   for Source_Dirs use (".");
   for Object_Dir use "../obj/examples";
   for Exec_Dir use "../bin";
   for Main use ("write_sample.adb", "read_dump.adb", "convert_summary.adb",
                  "streaming_dump.adb", "bench.adb");
   for Create_Missing_Dirs use "True";

   package Compiler is
      for Default_Switches ("Ada") use
        ("-gnat2022", "-gnatwa", "-gnata", "-gnato", "-O2");
   end Compiler;

end Examples;
