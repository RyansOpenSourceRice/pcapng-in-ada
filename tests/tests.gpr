with "../pcapng_in_ada.gpr";

project Tests is

   for Source_Dirs use (".");
   for Object_Dir use "../obj/tests";
   for Exec_Dir use "../bin";
   for Main use ("test_reader.adb", "test_malformed.adb");
   for Create_Missing_Dirs use "True";

   package Compiler is
      for Default_Switches ("Ada") use
        ("-gnat2022", "-gnatwa", "-gnata", "-gnato", "-O2");
   end Compiler;

   package Builder is
      for Default_Switches ("Ada") use ("-s");
   end Builder;

end Tests;
